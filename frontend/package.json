{
	"name": "supersaw-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"validate": "yarn typecheck && yarn lint && yarn format"
	},
	"devDependencies": {
		"@anarkisti/eslint-config": "^1.1.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25",
		"eslint": "^10.5.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.1.0"
	},
	"packageManager": "yarn@4.16.0",
	"dependencies": {
		"@lucide/svelte": "^1.20.0"
	}
}
